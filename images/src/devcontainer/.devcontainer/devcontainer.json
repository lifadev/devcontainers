{
  "image": "debian:trixie-20260803",
  "features": {
    "ghcr.io/lifadev/devcontainers/features/aws2": {},
    "ghcr.io/lifadev/devcontainers/features/base": {},
    "ghcr.io/lifadev/devcontainers/features/bash": {},
    "ghcr.io/lifadev/devcontainers/features/claude": {},
    "ghcr.io/lifadev/devcontainers/features/codex": {},
    "ghcr.io/lifadev/devcontainers/features/developer": {},
    "ghcr.io/lifadev/devcontainers/features/docker": {},
    "ghcr.io/lifadev/devcontainers/features/gh": {},
    "ghcr.io/lifadev/devcontainers/features/go": {},
    "ghcr.io/lifadev/devcontainers/features/jujutsu": {},
    "ghcr.io/lifadev/devcontainers/features/node24": {},
    "ghcr.io/lifadev/devcontainers/features/python314": {},
    "ghcr.io/lifadev/devcontainers/features/ruff": {},
    "ghcr.io/lifadev/devcontainers/features/rust": {},
    "ghcr.io/lifadev/devcontainers/features/starship": {},
    "ghcr.io/lifadev/devcontainers/features/uv": {}
  },
  "remoteUser": "developer",
  "updateRemoteUserUID": true,
  "remoteEnv": {
    "PATH": "/home/developer/.local/bin:/opt/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "extensions.ignoreRecommendations": true,
        "json.schemas": [
          {
            "fileMatch": ["*/devcontainer-feature.json"],
            "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
          }
        ]
      }
    },
    "manifest": {
      "name": "devcontainer",
      "version": "2026.8.23"
    }
  }
}
