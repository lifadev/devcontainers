{
  "default": {
    "image": "dhi.io/debian-base:trixie",
    "features": {
      "developer": {
        "sudo-commands": "/opt/init/iptables.sh"
      },
      "iptables": {}
    },
    "overrideFeatureInstallOrder": ["./developer"],
    "remoteEnv": {
      "DOMAIN_ALLOWLIST": "github.com,registry.npmjs.org"
    },
    "runArgs": ["--cap-add=NET_ADMIN"],
    "waitFor": "postStartCommand"
  }
}
