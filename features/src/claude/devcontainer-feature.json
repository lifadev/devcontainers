{
  "id": "claude",
  "name": "claude",
  "version": "2026.8.18",
  "installsAfter": ["ghcr.io/lifadev/devcontainers/features/developer"],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/mnt/claude",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "mounts": [
    {
      "source": "claude-${devcontainerId}",
      "target": "/mnt/claude",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "cli",
          "version": "2.1.235",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/anthropics/claude-code"
        }
      ]
    }
  }
}
