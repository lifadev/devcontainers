{
  "id": "codex",
  "name": "codex",
  "version": "2026.9.26",
  "installsAfter": ["ghcr.io/lifadev/devcontainers/features/developer"],
  "containerEnv": {
    "CODEX_HOME": "/mnt/codex"
  },
  "mounts": [
    {
      "source": "codex-${devcontainerId}",
      "target": "/mnt/codex",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": ["openai.chatgpt"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "cli",
          "version": "0.157.0",
          "hint": "releases/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/openai/codex",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://github.com/openai/codex/releases/download/rust-v${VERSION}/codex-x86_64-unknown-linux-musl.tar.gz",
              "checksum": "db3fe3adaa35c50edfb68a988a117782fe3492960fb63d7003eb6748ccc0657b"
            },
            {
              "architecture": "arm64",
              "url": "https://github.com/openai/codex/releases/download/rust-v${VERSION}/codex-aarch64-unknown-linux-musl.tar.gz",
              "checksum": "e6fbe2798e941b833f7e3bc34010f7443240ac4a149ce1876f32cbfa0ba7d25f"
            }
          ]
        }
      ]
    }
  }
}
