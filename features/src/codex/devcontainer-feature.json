{
  "id": "codex",
  "name": "codex",
  "version": "2026.1.31",
  "installsAfter": ["ghcr.io/lifadev/devcontainers/features/developer"],
  "containerEnv": {
    "CODEX_HOME": "/mnt/codex"
  },
  "mounts": [
    {
      "source": "codex-${devcontainerId}",
      "target": "/mnt/codex",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": ["openai.chatgpt"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "cli",
          "version": "0.93.0",
          "hint": "releases/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/openai/codex",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://github.com/openai/codex/releases/download/rust-v${VERSION}/codex-x86_64-unknown-linux-gnu.tar.gz",
              "checksum": "c0343fc310c4427c638c202fb4f28ec94e624d212a3eced20035ed1ca5875621"
            },
            {
              "architecture": "arm64",
              "url": "https://github.com/openai/codex/releases/download/rust-v${VERSION}/codex-aarch64-unknown-linux-gnu.tar.gz",
              "checksum": "66726828e9e15fc2738a39b3782b8a8cce716e33d35c4b2119c5f7fc108ecbd4"
            }
          ]
        }
      ]
    }
  }
}
