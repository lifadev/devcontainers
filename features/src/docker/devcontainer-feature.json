{
  "id": "docker",
  "name": "docker",
  "version": "2026.4.13",
  "installsAfter": ["ghcr.io/lifadev/devcontainers/features/developer"],
  "privileged": true,
  "postStartCommand": "sudo -E /opt/init/docker.sh",
  "mounts": [
    {
      "source": "docker-${devcontainerId}",
      "target": "/var/lib/docker",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": ["docker.docker", "ms-azuretools.vscode-docker"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "cli",
          "version": "29.4.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/docker/cli",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://download.docker.com/linux/static/test/x86_64/docker-${VERSION}.tgz",
              "checksum": "56c90317a05d86bd84f2bf8d086faefce6f31f82e8c92880de7710dd5f8ce5b7"
            },
            {
              "architecture": "arm64",
              "url": "https://download.docker.com/linux/static/test/aarch64/docker-${VERSION}.tgz",
              "checksum": "f3b260fd888b12b34dc01b92c1e4d2576b1167a7d7e60e923d5782798fbefeb7"
            }
          ]
        },
        {
          "name": "buildx",
          "version": "0.33.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/docker/buildx",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://github.com/docker/buildx/releases/download/v${VERSION}/buildx-v${VERSION}.linux-amd64",
              "checksum": "9426a15411f35f635afef3f5d3bae53155c3e30d26dee430cc968e13d34be49f"
            },
            {
              "architecture": "arm64",
              "url": "https://github.com/docker/buildx/releases/download/v${VERSION}/buildx-v${VERSION}.linux-arm64",
              "checksum": "204dc28447d3bb48f42ed1ce5747e0885cd57e306506a39029311becdb1ef786"
            }
          ]
        },
        {
          "name": "compose",
          "version": "5.1.2",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/docker/compose",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://github.com/docker/compose/releases/download/v${VERSION}/docker-compose-linux-x86_64",
              "checksum": "c372e512a36e67716b0b3a1264ccdc461dec7a7beff601b81f7c5fb008e3511e"
            },
            {
              "architecture": "arm64",
              "url": "https://github.com/docker/compose/releases/download/v${VERSION}/docker-compose-linux-aarch64",
              "checksum": "d5ce4020039cdbe81679b770e64f89d2cc601398d3b1aacd84a02a9176cd9d20"
            }
          ]
        }
      ]
    }
  }
}
