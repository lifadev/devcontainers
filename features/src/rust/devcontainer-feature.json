{
  "id": "rust",
  "name": "rust",
  "version": "2025.12.16",
  "containerEnv": {
    "PATH": "/opt/rust/bin:$PATH"
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "rust",
          "version": "1.92.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/rust-lang/rust",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://static.rust-lang.org/dist/rust-${VERSION}-x86_64-unknown-linux-gnu.tar.xz",
              "checksum": "d2ccef59dd9f7439f2c694948069f789a044dc1addcc0803613232af8f88ee0c"
            },
            {
              "architecture": "arm64",
              "url": "https://static.rust-lang.org/dist/rust-${VERSION}-aarch64-unknown-linux-gnu.tar.xz",
              "checksum": "3e383f8b4fca710d0600d0c1de97b78281672be2cda6575ecbe1c183a12e3822"
            }
          ]
        },
        {
          "name": "rust-src",
          "version": "1.92.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/rust-lang/rust",
          "artifacts": [
            {
              "architecture": "universal",
              "url": "https://github.com/rust-lang/rust/archive/refs/tags/${VERSION}.tar.gz",
              "checksum": "3b8f9c1f631d325022fde734c18848ff6463c47201803f5aae1e0c777f60bf0d"
            }
          ]
        }
      ]
    }
  }
