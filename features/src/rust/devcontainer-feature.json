{
  "id": "rust",
  "name": "rust",
  "version": "2026.1.22",
  "containerEnv": {
    "PATH": "/opt/rust/bin:$PATH"
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    },
    "manifest": {
      "dependencies": [
