{
  "id": "rust",
  "name": "rust",
  "version": "2026.3.5",
  "containerEnv": {
    "PATH": "/opt/rust/bin:$PATH"
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    },
    "manifest": {
      "dependencies": [
