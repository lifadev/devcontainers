              "checksum": "b9d9f01a96a2542852ccfddd82194276ba1c86bc76353309ff636b737fc0a772"
            },
            {
              "architecture": "arm64",
              "url": "https://static.rust-lang.org/dist/rust-${VERSION}-aarch64-unknown-linux-gnu.tar.xz",
              "checksum": "b666c705a334792a3eeb1d5984c8b24817f107bc986c6b09dcfd15a0d95b2b6a"
            }
          ]
        },
        {
          "name": "rust-src",
          "version": "1.93.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/rust-lang/rust",
          "artifacts": [
            {
              "architecture": "universal",
              "url": "https://github.com/rust-lang/rust/archive/refs/tags/${VERSION}.tar.gz",
              "checksum": "79cb56d3b35c4b79d17e957212863a18eb7675a64384abfdb4a2b9948426d7a1"
