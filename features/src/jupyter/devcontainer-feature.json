{
  "id": "jupyter",
  "name": "jupyter",
  "version": "2026.8.31",
  "installsAfter": ["ghcr.io/lifadev/devcontainers/features/python314"],
  "customizations": {
    "vscode": {
      "extensions": ["ms-toolsai.jupyter"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "ipykernel",
          "version": "7.3.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/ipython/ipykernel"
        },
        {
          "name": "ipympl",
          "version": "0.10.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/matplotlib/ipympl"
        },
        {
          "name": "matplotlib",
          "version": "3.11.1",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/matplotlib/matplotlib"
        },
        {
          "name": "numpy",
          "version": "2.5.2",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/numpy/numpy"
        }
      ]
    }
  }
}
