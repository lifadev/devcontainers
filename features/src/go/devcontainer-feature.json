{
  "id": "go",
  "name": "go",
  "version": "2026.8.17",
  "containerEnv": {
    "PATH": "/opt/go/bin:$PATH"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.toolsGopath": "/opt/go/vscode"
      },
      "extensions": ["golang.go"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "go",
          "version": "1.26.6",
          "hint": "tags/gov?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/golang/go",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://go.dev/dl/go${VERSION}.linux-amd64.tar.gz",
              "checksum": "708effb774be8237570d0add163225abbdfaf4fca28b2611df167beba4feef89"
            },
            {
              "architecture": "arm64",
              "url": "https://go.dev/dl/go${VERSION}.linux-arm64.tar.gz",
              "checksum": "d0507e9e9d7fe012aae570108cbd76c15de879e17130ab8cb90d4d7445cb1f2e"
            }
          ]
        },
        {
          "name": "gotests",
          "version": "1.9.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/cweill/gotests"
        },
        {
          "name": "gomodifytags",
          "version": "1.17.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/fatih/gomodifytags"
        },
        {
          "name": "dlv",
          "version": "1.27.1",
