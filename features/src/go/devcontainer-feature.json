{
  "id": "go",
  "name": "go",
  "version": "2026.8.25",
  "containerEnv": {
    "PATH": "/opt/go/bin:$PATH"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "go.toolsGopath": "/opt/go/vscode"
      },
      "extensions": ["golang.go"]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "go",
          "version": "1.27.0",
          "hint": "tags/gov?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/golang/go",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://go.dev/dl/go${VERSION}.linux-amd64.tar.gz",
              "checksum": "675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685"
            },
            {
              "architecture": "arm64",
              "url": "https://go.dev/dl/go${VERSION}.linux-arm64.tar.gz",
              "checksum": "51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda"
            }
          ]
        },
        {
          "name": "gotests",
          "version": "1.9.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/cweill/gotests"
        },
        {
          "name": "gomodifytags",
          "version": "1.17.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
