{
  "id": "bash",
  "name": "bash",
  "version": "2026.4.7",
  "installsAfter": ["ghcr.io/lifadev/devcontainers/features/developer"],
  "containerEnv": {
    "HISTFILE": "/mnt/bash/.bash_history"
  },
  "mounts": [
    {
      "source": "bash-${devcontainerId}",
      "target": "/mnt/bash",
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "shellcheck.executablePath": "/opt/bin/shellcheck",
        "shellformat.path": "/opt/bin/shfmt",
        "shellformat.useEditorConfig": true,
        "[shellscript]": {
          "editor.defaultFormatter": "foxundermoon.shell-format"
        }
      },
      "extensions": [
        "foxundermoon.shell-format",
        "mads-hartmann.bash-ide-vscode",
        "timonwong.shellcheck"
      ]
    },
    "manifest": {
      "dependencies": [
        {
          "name": "shellcheck",
          "version": "0.11.0",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/koalaman/shellcheck",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://github.com/koalaman/shellcheck/releases/download/v${VERSION}/shellcheck-v${VERSION}.linux.x86_64.tar.xz",
              "checksum": "8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"
            },
            {
              "architecture": "arm64",
              "url": "https://github.com/koalaman/shellcheck/releases/download/v${VERSION}/shellcheck-v${VERSION}.linux.aarch64.tar.xz",
              "checksum": "12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588"
            }
          ]
        },
        {
          "name": "shfmt",
          "version": "3.13.1",
          "hint": "tags/v?[0-9]+\\.[0-9]+(\\.[0-9]+)?",
          "repository": "github.com/mvdan/sh",
          "artifacts": [
            {
              "architecture": "amd64",
              "url": "https://github.com/mvdan/sh/releases/download/v${VERSION}/shfmt_v${VERSION}_linux_amd64",
              "checksum": "fb096c5d1ac6beabbdbaa2874d025badb03ee07929f0c9ff67563ce8c75398b1"
            },
            {
              "architecture": "arm64",
              "url": "https://github.com/mvdan/sh/releases/download/v${VERSION}/shfmt_v${VERSION}_linux_arm64",
              "checksum": "32d92acaa5cd8abb29fc49dac123dc412442d5713967819d8af2c29f1b3857c7"
            }
          ]
        }
      ]
    }
  }
}
